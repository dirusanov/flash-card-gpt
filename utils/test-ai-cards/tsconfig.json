{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "lib": ["es2019", "dom"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "./.compiled",
    "rootDir": "../.."
  },
  "include": [
    "./chrome-shim.d.ts",
    "../../src/services/aiServiceFactory.ts",
    "../../src/services/aiProviders.ts",
    "../../src/services/openaiApi.ts",
    "../../src/services/backgroundFetch.ts",
    "../../src/services/apiTracker.ts",
    "../../src/services/languageNames.ts",
    "../../src/services/promptCache.ts",
    "../../src/services/imagePromptSafety.ts",
    "../../src/services/errorFormatting.ts",
    "../../src/store/reducers/settings.ts",
    "../../src/store/actions/settings.ts",
    "../../src/constants.ts"
  ]
}
