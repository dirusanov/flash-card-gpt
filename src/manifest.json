{
  "manifest_version": 3,
  "key": "",
  "name": "Vaulto Cards",
  "version": "5.1.5",
  "description": "Turn selected page text into study cards with AI, optional Anki export, and Vaulto sync",
  "options_page": "options.html",
  "background": {
    "service_worker": "background.bundle.js"
  },
  "action": {
    "default_title": "Vaulto Cards"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "create-card-from-selection": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Create a card from the selected text"
    }
  },
  "icons": {
    "16": "logo-16.png",
    "48": "logo-48.png",
    "128": "logo-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "contentScript.bundle.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "contextMenus",
    "identity",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://oaidalleapiprodscus.blob.core.windows.net/*",
    "https://auth.vaultonote.com/*",
    "https://api-cards.vaultonote.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
